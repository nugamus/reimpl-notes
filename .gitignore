# Game data: disc images and their extracted files. Read-only source material, tens of GB
# and not ours to redistribute. Keep it on disk, out of the repo.
games/*/discs/
games/*/images/

# Saved web pages (ScummVM wiki) for reference
reference/

# Vendored toolchains (Ghidra, PE-bear, dgVoodoo2). Reinstallable, hundreds of MB.
third_party/

# Cloned upstream MCP server, has its own git history.
tools/ghidra/mcp/

# Ghidra
*.rep/
*.gpr
*.lock
*.lock~
ghidra_projects/

# Tool logs (headless analysis, builds). Regenerated, noisy.
logs/

# Proxy traces: large, machine-specific, regenerated per run. Golden traces that a test
# depends on get force-added and named engines/x3d/traces/golden-*.log.
engines/*/traces/*.log
!engines/*/traces/golden-*.log

# Build output
build/
dist/
*.obj
*.o
*.lib
*.exp
*.pdb
*.ilk

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Captures of the original (game imagery, not ours to redistribute)
engines/*/traces/*.png

# Save files copied from runs of the original (binary, machine-specific).
engines/x3d/traces/save/
engines/x3d/traces/inv/

# Decompiler output and disassembly of the original executables. Reference material for
# the analysis, but it is the publisher's code: never commit it.
**/notes/decomp/

# Downloaded game files, patches and archives
*.zip
*.7z
*.rar
*.iso
*.cue
*.bin
*.exe
*.dll

# Local assistant and tool configuration
CLAUDE.md
.claude/
.mcp.json

# Stray copy of a play build (old quoting bug in build_play.sh)
/tools/play/C*/

# Scenario references and run output: game imagery, never published
engines/*/tests/golden/
engines/*/tests/out/
